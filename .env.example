# Copy to .env.local and fill in. Names only — never commit real values.

# Server-side only. Used by scripts/generate-images.mjs during development.
# Must never be exposed through a NEXT_PUBLIC_ variable.
OPENAI_API_KEY=

# Absolute origin used for canonical URLs, sitemap, and Open Graph metadata.
NEXT_PUBLIC_SITE_URL=

# AgentBazar (Tripforu) Fixed Departure API for the /flights section.
# Server-side only — never expose through NEXT_PUBLIC_. The staging URL and
# test key come from their API kit; production credentials come from AgentBazar
# once Smarto's agency account is approved.
AGENTBAZAR_API_URL=
AGENTBAZAR_API_KEY=
# "true" lets the booking page issue real tickets against Smarto's agency
# wallet. Leave unset/false until Manav signs off on payment collection.
AGENTBAZAR_LIVE_BOOKING=false
